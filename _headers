# Cloudflare Pages cache rules.
#
# Before this file every asset came back as `max-age=0, must-revalidate`, so a repeat
# visitor revalidated ~13 files on every single page view. Fonts and images here never
# change under a given name, so they are safe to pin for a year.
#
# Note the tradeoff: these filenames are NOT content-hashed, so a cached client keeps the
# old bytes for up to a year. If you edit an image or a font in place, rename it (or add
# ?v=2 where it is referenced) or the change will not reach anyone who already visited.

# Fonts: same bytes forever under these names.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images: same deal, they are only ever replaced by a new filename.
/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Icons: long-lived, but a month rather than a year so a rebrand lands without a rename.
/favicon.svg
  Cache-Control: public, max-age=2592000
/favicon.png
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

# The stylesheet IS edited in place on every Tailwind rebuild, so it cannot be immutable.
# Five minutes at the edge, then revalidate: a deploy reaches visitors quickly.
/assets/styles.css
  Cache-Control: public, max-age=300, must-revalidate

# HTML: short, so copy and price changes go live fast.
/*.html
  Cache-Control: public, max-age=300, must-revalidate
/
  Cache-Control: public, max-age=300, must-revalidate

# The bridge pages. Short cache rather than must-revalidate, so the landing page's
# <link rel="prefetch"> is actually reusable when the buyer taps: revalidating would put
# the round trip right back onto the conversion path. Ten minutes, so an edit here still
# reaches people quickly.
/go/*
  Cache-Control: public, max-age=600
  X-Robots-Tag: noindex
